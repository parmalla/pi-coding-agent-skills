# ============================================================================
# Pi Web Access — provider API keys
# ============================================================================
# 1. Create each key at the URL in the comment above the variable.
# 2. Paste it between the quotes. Leave blank to keep that provider off.
# 3. Check progress:   web-keys-status.sh   (next to this file)
# 4. Keys resolve per request, so no Pi restart is needed after editing.
#
# Keep this file private: chmod 600 web-search-keys.env
# Full provider matrix: skills/pi-web-access/reference/providers.md
# ============================================================================

# ---------------------------------------------------------------------------
# TIER 1 — free tier, used by the `auto`/routing search chain
# ---------------------------------------------------------------------------

# Exa — $10 free credits/month (≈2,500 searches), resets monthly.
# Create: https://dashboard.exa.ai/api-keys
EXA_API_KEY=""

# Brave Search — free plan: 2,000 queries/month, 1 query/s.
# Create: https://api.search.brave.com/app/keys  (signup: https://brave.com/search/api/)
BRAVE_API_KEY=""

# Tavily — 1,000 free credits/month, no card.
# Create: https://app.tavily.com/home
TAVILY_API_KEY=""

# Jina AI (Search + Reader) — free API key, high rate limit (500 RPM).
# Create: https://jina.ai/api-dashboard/key-manager
JINA_API_KEY=""

# Firecrawl — 1,000 free credits/month (search + scrape).
# Create: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=""

# Google Gemini API — free tier (grounded search + YouTube/video/PDF).
# Create: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# TinyFish — Search + Fetch, documented as credit-free; key still required.
# Create: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=""

# Search1API — credit-based, free credits on signup (1 credit/search).
# Create: https://dashboard.search1api.com
SEARCH1API_KEY=""

# BytePlus Searchinfinity — monthly free quota (global Doubao/Volcengine).
# Create: https://console.byteplus.com/search-infinity/api-key
SEARCHINFINITY_API_KEY=""

# Querit — free credits on signup (Search; Contents is a separate sub).
# Create: https://www.querit.ai/en/dashboard/api-keys
QUERIT_API_KEY=""

# SERPdive — `krill` model is free/fair-use (default, pinned in config).
# Create: https://serpdive.com/dashboard/keys
SERPDIVE_API_KEY=""

# ---------------------------------------------------------------------------
# TIER 2 — free credits on signup / monthly free credits (explicit-only)
# ---------------------------------------------------------------------------

# Serper.dev — 2,500 free credits on signup, no card.
# Create: https://serper.dev/signup
SERPER_API_KEY=""

# SerpApi — free plan: 250 searches/month.
# Create: https://serpapi.com/users/sign_up?plan=free
SERPAPI_KEY=""

# SerpBase — 100 free searches on signup.
# Create: https://serpbase.dev/register
SERPBASE_API_KEY=""

# Serply — free tier, no card.
# Create: https://serply.io/  (key in dashboard)
SERPLY_API_KEY=""

# Valyu — $10 free credits ($20 with a work email), research search.
# Create: https://platform.valyu.ai/
VALYU_API_KEY=""

# Bright Data — 5,000 free credits/month, no card. SERP needs a zone of
# type `serp`; add "brightdataSerpZone": "<zone>" to web-search.json after
# creating it.
# Token:  https://brightdata.com/cp/setting/users
# Zones:  https://brightdata.com/cp/zones
BRIGHTDATA_API_KEY=""

# Mistral — free tier ("Free mode", no card) for Conversations + web_search.
# Create: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=""

# Ollama Cloud — free tier of web search (same key as cloud inference).
# Create: https://ollama.com/settings/keys
OLLAMA_API_KEY=""

# XCrawl — free credits on signup.
# Create: https://dash.xcrawl.com/
XCRAWL_API_KEY=""

# You.com — $100 free trial credits, no card.
# Create: https://you.com/platform  (API Keys section)
YDC_API_KEY=""

# Bocha (博查) — Chinese web search, free trial quota.
# Create: https://open.bochaai.com/
BOCHA_API_KEY=""

# Parallel — $5 free credits/month (card on file); REST search API.
# Note: `parallel-mcp` is keyless and needs no key at all.
# Create: https://platform.parallel.ai/
PARALLEL_API_KEY=""

# Datalab — $10 free credit/month (Marker PDF extraction), 25 req/min.
# Create: https://www.datalab.to/app/apikeys
DATALAB_API_KEY=""

# AnySearch — works anonymously (no key). Optional key raises limits.
# Create: https://anysearch.com/ (optional)
ANYSEARCH_API_KEY=""

# ---------------------------------------------------------------------------
# TIER 3 — paid or subscription. Leave blank unless you have one.
# ---------------------------------------------------------------------------

# OpenAI — paid API key. Not needed if you use Codex/ChatGPT login in Pi.
# Create: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Perplexity — API is pay-as-you-go; Pro subscribers get $5/month credit.
# Create: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=""

# xAI (Grok) — pay-as-you-go. SuperGrok / X Premium are used automatically
# through Pi's model registry, so no key is needed for those accounts.
# Create: https://console.x.ai/
XAI_API_KEY=""

# Kagi — Search API requires a paid Kagi plan (no free tier).
# Create: https://kagi.com/settings?p=api
KAGI_API_KEY=""

# Z.ai — GLM Coding Plan key (quota-based, not free).
# Create: https://docs.z.ai/devpack/mcp/search-mcp-server
ZAI_API_KEY=""

# Baizhi Cloud Agent Toolkit — commercial credits.
# Create: https://baizhi.cloud/landing/agent-toolkit
BAIZHI_API_KEY=""
